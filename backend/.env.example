# Configuration locale : copier en backend/.env puis renseigner.
# Toutes les variables commencent par ANSD_ (voir app/core/config.py).

# demo : hors ligne et déterministe ; production : modèle de langage via API
ANSD_MODE=demo

# Fournisseur : groq | mistral | deepseek | openai | openrouter | ollama
ANSD_LLM_PROVIDER=groq
ANSD_LLM_API_KEY=

# Facultatif : autre modèle ou autre adresse que ceux du fournisseur
# ANSD_LLM_MODEL=openai/gpt-oss-120b
# ANSD_LLM_BASE_URL=https://api.groq.com/openai/v1

# Modèle local, sans clé : installer Ollama puis « ollama pull llama3.1 »
# ANSD_LLM_PROVIDER=ollama
# ANSD_LLM_MODEL=llama3.1

# Réseau et sécurité
# ANSD_LLM_TIMEOUT_S=20
# ANSD_LLM_MAX_RETRIES=1
# ANSD_CORS_ORIGINS=https://www.ansd.sn,https://ansd.sn
# ANSD_TRUST_PROXY=true
