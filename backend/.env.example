# RAMA-ANSD — configuration (copier vers .env puis renseigner)
# Toutes les variables sont prefixees ANSD_ (voir app/core/config.py)

# ---- Mode d'execution -------------------------------------------------
# demo       : 100 % hors-ligne (MockLLM deterministe) — soutenance, tests
# production : LLM reel via API compatible OpenAI
ANSD_MODE=demo

# ---- Fournisseur LLM (mode production) --------------------------------
# Choix : deepseek | openai | groq | mistral | openrouter | ollama
# DeepSeek-V3 est le modele de reference du memoire (cle sur platform.deepseek.com)
ANSD_LLM_PROVIDER=deepseek
ANSD_LLM_API_KEY=

# Surcharges optionnelles (sinon presets du fournisseur) :
# ANSD_LLM_MODEL=deepseek-chat
# ANSD_LLM_BASE_URL=https://api.deepseek.com/v1
# ANSD_LLM_TIMEOUT_S=60
# ANSD_LLM_MAX_RETRIES=2

# Exemple modele LOCAL gratuit (aucune cle requise) :
#   installer https://ollama.com puis `ollama pull llama3.1`
# ANSD_LLM_PROVIDER=ollama
# ANSD_LLM_MODEL=llama3.1

# ---- RAG production ----------------------------------------------------
# ANSD_QDRANT_URL=http://localhost:6333

# ---- Cache -------------------------------------------------------------
# ANSD_CACHE_ENABLED=true
# ANSD_CACHE_TTL_S=600

# ---- Robustesse / réseau ----------------------------------------------
# Timeout court + peu de tentatives = repli local rapide sur réseau faible
# ANSD_LLM_TIMEOUT_S=20
# ANSD_LLM_MAX_RETRIES=1
# ANSD_LLM_MAX_CONCURRENCY=6      # appels LLM distants simultanés max

# ---- Sécurité / déploiement -------------------------------------------
# En production, restreindre CORS au domaine ANSD (liste séparée par des virgules)
# ANSD_CORS_ORIGINS=https://www.ansd.sn,https://ansd.sn
# À activer UNIQUEMENT derrière un proxy de confiance (nginx) qui pose
# X-Forwarded-For — sinon un client pourrait usurper son IP (rate-limit)
# ANSD_TRUST_PROXY=true
