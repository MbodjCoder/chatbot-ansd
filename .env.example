# Variables de déploiement (docker compose) : copier en .env à côté de
# docker-compose.yml. Ce fichier n'entre jamais dans l'image ni dans le dépôt.

# Fournisseur du modèle de langage : groq | mistral | deepseek | openai | openrouter | ollama
ANSD_LLM_PROVIDER=groq
ANSD_LLM_API_KEY=

# auto : modèle de langage si l'API est rapide, moteurs déterministes sinon
ANSD_LLM_GEN=auto
ANSD_LLM_AUX=auto

# Domaines autorisés à appeler l'API depuis un autre site
ANSD_CORS_ORIGINS=https://www.ansd.sn,https://ansd.sn

# true uniquement derrière un proxy de confiance
ANSD_TRUST_PROXY=false
