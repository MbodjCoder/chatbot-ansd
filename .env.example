# === Variables de déploiement RAMA (docker compose) ===
# Copier en `.env` À CÔTÉ de docker-compose.yml puis renseigner.
# Ce fichier .env est ignoré par git ET par docker (.dockerignore) — jamais
# dans l'image ni le dépôt.

# Fournisseur LLM : groq | deepseek | openai | mistral | openrouter | ollama
ANSD_LLM_PROVIDER=groq

# Clé API du fournisseur choisi (OBLIGATOIRE en production)
ANSD_LLM_API_KEY=

# Stratégie latence/qualité : auto (LLM si fournisseur rapide, sinon déterministe)
ANSD_LLM_GEN=auto
ANSD_LLM_AUX=auto

# Domaines autorisés à appeler l'API depuis un AUTRE origine (l'UI embarquée
# est même-origine et n'en a pas besoin). Liste séparée par des virgules.
ANSD_CORS_ORIGINS=https://www.ansd.sn,https://ansd.sn

# Mettre true UNIQUEMENT derrière un reverse-proxy de confiance (nginx/caddy)
ANSD_TRUST_PROXY=false
